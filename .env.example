# Copy to .env.local for local work. Never commit real values.
# Vars without NEXT_PUBLIC_ are server-only and never reach the browser.

# ---- Build / site ----
# "true" lets placeholder content and needsReview FAQs build. Leave unset in production.
ALLOW_PLACEHOLDERS=true
# Canonical origin for metadata, OG and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.staystory.in

# ---- Analytics ----
# Google Tag Manager container (GTM-XXXXXXX). When set, a successful enquiry pushes
# { event: "generate_lead", lead_type, lead_source } to window.dataLayer.
NEXT_PUBLIC_GTM_ID=

# ---- Lead sinks (POST /api/enquiry) ----
# Each sink runs independently; the API returns 200 if at least one succeeds, else 502.
# With no sink configured, dev logs the lead and returns 200; production returns 502.

# Resend email. All three are required to enable it.
RESEND_API_KEY=
# Comma-separated recipients.
LEAD_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "StayStory Leads <leads@staystory.in>".
LEAD_FROM_EMAIL=

# Supabase insert into public.enquiries (run supabase/migrations/0001_enquiries.sql first).
# Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Service-role key: bypasses RLS. Server only; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google Sheet (or any) webhook; receives the lead as a JSON POST body.
SHEET_WEBHOOK_URL=

# ---- Spam protection ----
# Upstash Redis REST for the 5-per-10-minutes-per-IP limit. Without both, an in-memory
# per-instance limiter is used and a warning is logged once.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile. Set both to enable: the site key renders the widget,
# the secret key makes the API verify it. Note: Turnstile needs JS, so no-JS posts fail while it is on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
